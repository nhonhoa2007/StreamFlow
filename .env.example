# StreamFlow Environment Configuration
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/streamflow
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60
TRANSCODE_QUEUE_NAME=media-transcode-queue
TRANSCODE_CONCURRENCY=2
TRANSCODE_MAX_ATTEMPTS=3
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Set only for controlled local performance experiments; keep false/unset elsewhere.
# ENABLE_EXPERIMENTS=true

# Kafka distributed streaming (M09+)
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_PLAYBACK_TOPIC=media-playback-events
KAFKA_CONSUMER_GROUP=streamflow-analytics-group

# Future storage configuration (M04+)
# When using local MinIO via `make up-storage`:
# STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin
# STORAGE_BUCKET_NAME=streamflow-media-dev

# When using Cloudflare R2 (optional cloud staging/dev):
# STORAGE_PROVIDER=cloudflare_r2
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=<your-r2-access-key-id>
# STORAGE_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# STORAGE_BUCKET_NAME=streamflow-media
# STORAGE_PUBLIC_URL=https://media.yourdomain.com
