{
  "name": "@streamflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/src/main.js)",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "test:integration": "vitest run test/api.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@node-rs/argon2": "^2.0.2",
    "@streamflow/config": "workspace:*",
    "@streamflow/contracts": "workspace:*",
    "@streamflow/database": "workspace:*",
    "@streamflow/logger": "workspace:*",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
