{
  "name": "@streamflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./test-helper": "./test/test-helper.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run test/database.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/migrate.ts",
    "db:seed": "node --experimental-strip-types src/seed.ts"
  },
  "dependencies": {
    "@streamflow/contracts": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
