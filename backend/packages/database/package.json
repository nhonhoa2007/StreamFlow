{
  "name": "@streamflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./dist/src/schema.js"
    },
    "./test-helper": {
      "types": "./dist/test/test-helper.d.ts",
      "default": "./dist/test/test-helper.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run test/database.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -b && node dist/src/migrate.js",
    "db:seed": "tsc -b && node dist/src/seed.js",
    "db:seed-10k": "tsc -b && node dist/src/seed-10k.js"
  },
  "dependencies": {
    "@streamflow/contracts": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
